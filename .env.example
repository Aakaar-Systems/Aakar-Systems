# Contact form delivery (Resend — https://resend.com).
# Without these, /api/contact returns an honest "not connected" error
# and the form tells the visitor their message was NOT delivered.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@aakaarsystems.com
CONTACT_FROM_EMAIL=Aakaar Systems <onboarding@resend.dev>

# Public site URL, used for canonical + OG tags.
NEXT_PUBLIC_SITE_URL=https://aakaarsystems.com

# WhatsApp Business number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@aakaarsystems.com
